{
  "name": "@smeltery/next-ui",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "lint": "biome lint .",
    "check": "bun run check:format && bun run lint && bun run check:types && bun run check:markdown && bun run check:docs && bun run check:budget && bun run check:unit",
    "check:format": "prettier --check .",
    "check:types": "tsc --noEmit",
    "check:markdown": "markdownlint-cli2",
    "check:docs": "bun scripts/check-docs.ts",
    "check:budget": "bun scripts/check-budgets.ts",
    "test:e2e": "playwright test",
    "verify": "bun run build && bun run test:e2e",
    "hooks:install": "pre-commit install --hook-type pre-commit --hook-type pre-push",
    "check:unit": "bun test tests/unit"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.294.0",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
    "next": "14.2.35",
    "react": "^19.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^0.14.7",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "1.8.3",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.16.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.3",
    "markdownlint-cli2": "^0.23.3",
    "postcss": "^8.4.45",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.6.2"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=22 <23"
  }
}
